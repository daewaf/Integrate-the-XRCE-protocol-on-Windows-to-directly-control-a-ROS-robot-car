# C#/WPF team standard 1.1. Template: merge with existing repository rules.
# No root=true: preserve inherited rules that are not explicitly configured here.
# Keep an existing BOM/EOL convention. CRLF + UTF-8 below are defaults only.

[*.{cs,xaml}]
indent_style = space
indent_size = 4
tab_width = 4
charset = utf-8
end_of_line = crlf
insert_final_newline = true
# Do not blindly strip whitespace inside C# raw strings or XAML text content.
# Remove meaningless trailing whitespace with syntax-aware review instead.
trim_trailing_whitespace = false

[*.cs]
csharp_style_namespace_declarations = block_scoped:suggestion
csharp_prefer_braces = true:suggestion
csharp_new_line_before_open_brace = types, methods, properties, accessors, control_blocks, anonymous_methods, local_functions
# Built-in type preference is not overridden: the standard permits var when clear.
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion
# No formatter width limit: long single-line requirements are reviewed manually.
# No blanket analyzer errors or source-generated file rewrites are enabled here.

# Private constants must be PascalCase, rather than the private-field prefix.
dotnet_naming_rule.private_constants_pascal.severity = suggestion
dotnet_naming_rule.private_constants_pascal.symbols = private_constants
dotnet_naming_rule.private_constants_pascal.style = pascal_case
dotnet_naming_symbols.private_constants.applicable_kinds = field
dotnet_naming_symbols.private_constants.applicable_accessibilities = private
dotnet_naming_symbols.private_constants.required_modifiers = const

dotnet_naming_rule.private_fields_underscore.severity = suggestion
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private

dotnet_naming_rule.private_properties_underscore.severity = suggestion
dotnet_naming_rule.private_properties_underscore.symbols = private_properties
dotnet_naming_rule.private_properties_underscore.style = underscore_camel
dotnet_naming_symbols.private_properties.applicable_kinds = property
dotnet_naming_symbols.private_properties.applicable_accessibilities = private

dotnet_naming_rule.visible_properties_pascal.severity = suggestion
dotnet_naming_rule.visible_properties_pascal.symbols = visible_properties
dotnet_naming_rule.visible_properties_pascal.style = pascal_case
dotnet_naming_symbols.visible_properties.applicable_kinds = property
dotnet_naming_symbols.visible_properties.applicable_accessibilities = public, internal, protected, protected_internal, private_protected

dotnet_naming_rule.interfaces_i_pascal.severity = suggestion
dotnet_naming_rule.interfaces_i_pascal.symbols = interfaces
dotnet_naming_rule.interfaces_i_pascal.style = interface_pascal
dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_symbols.interfaces.applicable_accessibilities = *

dotnet_naming_style.pascal_case.capitalization = pascal_case
dotnet_naming_style.underscore_camel.required_prefix = _
dotnet_naming_style.underscore_camel.capitalization = camel_case
dotnet_naming_style.interface_pascal.required_prefix = I
dotnet_naming_style.interface_pascal.capitalization = pascal_case
